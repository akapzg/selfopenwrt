#!/bin/sh /etc/rc.common
# ==============================================================================
# Early-Boot /opt Partition Recovery & Auto-Mount Service (START=18)
# Runs BEFORE network (START=20) and dockerd (START=99) on every boot,
# ensuring /opt (3rd partition, LABEL=DOCKER_DATA) is always restored after OTA.
# ==============================================================================

START=18

boot() {
    start
}

init_opt_dirs() {
    mkdir -p /opt/docker /opt/downloads/aria2 /opt/downloads/qbittorrent
    chmod 777 /opt/downloads /opt/downloads/aria2 /opt/downloads/qbittorrent 2>/dev/null || true
    chown -R aria2:aria2 /opt/downloads/aria2 2>/dev/null || true
}

start() {
    # Skip if /opt is already a mounted partition
    if grep -q " /opt " /proc/mounts 2>/dev/null; then
        init_opt_dirs
        return 0
    fi

    # 1. Identify root/boot partition device (supports sda / nvme0n1 / mmcblk0 / vda)
    local part_dev=""
    local root_partuuid=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline)
    if [ -n "$root_partuuid" ]; then
        part_dev=$(blkid -t PARTUUID="$root_partuuid" -o device 2>/dev/null | head -n1)
    fi
    if [ -z "$part_dev" ]; then
        local cmd_root=$(sed -n 's/.*root=\(\/dev\/[^ ]*\).*/\1/p' /proc/cmdline)
        if [ -n "$cmd_root" ] && [ "$cmd_root" != "/dev/root" ] && [ -b "$cmd_root" ]; then
            part_dev="$cmd_root"
        fi
    fi
    if [ -z "$part_dev" ]; then
        part_dev=$(awk '$2=="/boot" {print $1}' /proc/mounts 2>/dev/null | head -n1)
    fi
    if [ -z "$part_dev" ]; then
        part_dev=$(blkid -t TYPE="squashfs" -o device 2>/dev/null | head -n1)
    fi

    local disk_dev=""
    local part_prefix=""
    if [ -n "$part_dev" ]; then
        local pkname=$(lsblk -ndo PKNAME "$part_dev" 2>/dev/null | head -n1)
        if [ -n "$pkname" ] && [ -b "/dev/$pkname" ]; then
            disk_dev="/dev/$pkname"
        else
            case "$part_dev" in
                /dev/nvme*n*p*|/dev/mmcblk*p*|/dev/loop*p*)
                    disk_dev=$(echo "$part_dev" | sed 's/p[0-9]*$//')
                    ;;
                /dev/sd*[0-9]|/dev/vd*[0-9])
                    disk_dev=$(echo "$part_dev" | sed 's/[0-9]*$//')
                    ;;
            esac
        fi
    fi

    if [ -z "$disk_dev" ] || [ ! -b "$disk_dev" ]; then
        init_opt_dirs
        return 0
    fi

    case "$disk_dev" in
        /dev/nvme*|/dev/mmcblk*|/dev/loop*) part_prefix="${disk_dev}p" ;;
        *) part_prefix="${disk_dev}" ;;
    esac

    local opt_part="${part_prefix}3"
    local p2_name=$(basename "${part_prefix}2")
    local disk_name=$(basename "$disk_dev")

    # 2. Recreate 3rd partition boundary if missing (first flash or after OTA sysupgrade)
    if [ ! -b "$opt_part" ] && [ -f "/sys/class/block/$disk_name/size" ] && [ -f "/sys/class/block/$p2_name/start" ]; then
        local disk_sectors=$(cat "/sys/class/block/$disk_name/size" 2>/dev/null || echo 0)
        local p2_start=$(cat "/sys/class/block/$p2_name/start" 2>/dev/null || echo 0)
        local p2_size=$(cat "/sys/class/block/$p2_name/size" 2>/dev/null || echo 0)
        local p2_end=$((p2_start + p2_size))
        local free_sectors=$((disk_sectors - p2_end))

        # Require > 1 GiB (2097152 sectors of 512B) of unallocated space after partition 2
        if [ "$free_sectors" -gt 2097152 ]; then
            if command -v sgdisk >/dev/null 2>&1; then
                sgdisk -e "$disk_dev" >/dev/null 2>&1 || true
                sgdisk -n 3:0:0 -t 3:8300 -c 3:DOCKER_DATA "$disk_dev" >/dev/null 2>&1 || true
            fi
            partprobe "$disk_dev" >/dev/null 2>&1 || true
            sleep 1
            if [ ! -b "$opt_part" ] && command -v parted >/dev/null 2>&1; then
                parted -s "$disk_dev" unit s mkpart primary ext4 "${p2_end}s" 100% >/dev/null 2>&1 || true
                partprobe "$disk_dev" >/dev/null 2>&1 || true
                sleep 1
            fi
        fi
    fi

    # 3. Check filesystem signature: preserve existing DOCKER_DATA / ext4 on OTA, or format on first boot
    if [ -b "$opt_part" ]; then
        local fs_label=$(blkid -s LABEL -o value "$opt_part" 2>/dev/null)
        local fs_type=$(blkid -s TYPE -o value "$opt_part" 2>/dev/null)
        if [ "$fs_label" != "DOCKER_DATA" ] && [ "$fs_type" != "ext4" ]; then
            mkfs.ext4 -F -L "DOCKER_DATA" "$opt_part" >/dev/null 2>&1
        else
            e2fsck -y "$opt_part" >/dev/null 2>&1 || true
        fi

        local opt_uuid=$(blkid -s UUID -o value "$opt_part" 2>/dev/null)
        mkdir -p /opt
        mount -t ext4 -o rw,noatime "$opt_part" /opt >/dev/null 2>&1 || true

        if [ -n "$opt_uuid" ] && [ "$(uci -q get fstab.opt_data.uuid)" != "$opt_uuid" ]; then
            if ! uci -q get fstab.@global[0] >/dev/null 2>&1; then
                uci add fstab global >/dev/null 2>&1
                uci set fstab.@global[0].anon_swap='0'
                uci set fstab.@global[0].anon_mount='1'
                uci set fstab.@global[0].auto_swap='1'
                uci set fstab.@global[0].auto_mount='1'
                uci set fstab.@global[0].delay_root='5'
                uci set fstab.@global[0].check_fs='0'
            fi
            uci -q delete fstab.opt_data
            uci set fstab.opt_data='mount'
            uci set fstab.opt_data.uuid="$opt_uuid"
            uci set fstab.opt_data.target='/opt'
            uci set fstab.opt_data.enabled='1'
            uci set fstab.opt_data.options='rw,noatime'
            uci set fstab.opt_data.enabled_fsck='1'
            uci commit fstab
        fi
    fi

    init_opt_dirs
}
