# ==============================================================================
# Target Configuration: x86_64 (UEFI & Legacy BIOS, 2.5G/10G NICs, KVM, HDMI)
# ==============================================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_GRUB_TIMEOUT="3"

# Partitions & Image Format (32MB Kernel + 2048MB Rootfs, SquashFS Reset Support)
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# System Info & CPU Microcode
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_intel-microcode=y
CONFIG_PACKAGE_amd64-microcode=y

# Network Drivers: Realtek 1G / 2.5G / 5G / 10G & USB NIC
CONFIG_PACKAGE_kmod-r8168=y
# CONFIG_PACKAGE_kmod-r8169 is not set
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-r8126=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y

# Network Drivers: Intel & 10Gbe (i210/i225/i226/X520/X550/X710/Mellanox)
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-ixgbe=y
CONFIG_PACKAGE_kmod-i40e=y
CONFIG_PACKAGE_kmod-mlx4-core=y
CONFIG_PACKAGE_kmod-mlx5-core=y

# KVM Virtualization (Host /dev/kvm & Guest VirtIO / VMware)
CONFIG_PACKAGE_kmod-kvm-intel=y
CONFIG_PACKAGE_kmod-kvm-amd=y
CONFIG_PACKAGE_kmod-vhost=y
CONFIG_PACKAGE_kmod-vhost-net=y
CONFIG_PACKAGE_qemu-ga=y

# HDMI Terminal Output, Intel GPU Acceleration & Audio
CONFIG_PACKAGE_kmod-drm-i915=y
CONFIG_PACKAGE_i915-firmware-huc=y
CONFIG_PACKAGE_kmod-sound-hda-core=y
CONFIG_PACKAGE_kmod-sound-hda-intel=y
CONFIG_PACKAGE_kmod-sound-hda-codec-realtek=y
CONFIG_PACKAGE_kmod-sound-hda-codec-hdmi=y
CONFIG_PACKAGE_kmod-nvme=y
