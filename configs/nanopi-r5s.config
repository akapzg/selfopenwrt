# ==============================================================================
# Target Configuration: FriendlyARM NanoPi R5S / R5C (Rockchip RK3568)
# ==============================================================================
CONFIG_TARGET_rockchip=y
CONFIG_TARGET_rockchip_armv8=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5s=y
CONFIG_TARGET_DEVICE_rockchip_armv8_DEVICE_friendlyarm_nanopi-r5c=y

# Partitions & Image Format (32MB Kernel + 2048MB Rootfs, SquashFS Reset Support)
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_IMAGES_GZIP=y

# System Info & Hardware Drivers (RTC HYM8563, PWM Fan, R8125/RTL8152 2.5G NIC)
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_kmod-r8125=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-hwmon-pwmfan=y

# HDMI Terminal Output & Panfrost GPU Hardware Acceleration
CONFIG_PACKAGE_kmod-drm-rockchip=y
CONFIG_PACKAGE_kmod-drm-panfrost=y
CONFIG_PACKAGE_kmod-nvme=y
