#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

start_service() {
	config_load homebox
	local enabled host port
	config_get_bool enabled config enabled 1
	config_get host config host "0.0.0.0"
	config_get port config port "3300"

	[ "$enabled" -eq 0 ] && return 0

	procd_open_instance
	procd_set_param command /usr/bin/homebox serve --host "$host" --port "$port"
	procd_set_param respawn
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "homebox"
}
