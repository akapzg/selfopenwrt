#!/bin/sh
# ==============================================================================
# LuCI USB Disk Image Writer Backend (/usr/libexec/usb-writer)
# Features:
#   - Hardware-level System Disk Lock (never lists or touches boot/root disk)
#   - Supports .img, .img.gz, .img.xz, .iso, .bin, .raw
#   - Real-time kernel fdinfo progress tracking (0-100%, MB written, MB/s, sync)
# ==============================================================================

STATE_DIR="/tmp/usb-writer"
STATE_FILE="$STATE_DIR/state.json"
WORKER_SCRIPT="$STATE_DIR/worker.sh"
ERR_LOG="$STATE_DIR/dd.err"

mkdir -p "$STATE_DIR" /opt/downloads 2>/dev/null || true

json_escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/ /g' -e 's/\r//g'
}

human_size() {
	local bytes="${1:-0}"
	awk -v b="$bytes" 'BEGIN {
		if (b >= 1073741824) printf "%.2f GB", b / 1073741824;
		else if (b >= 1048576) printf "%.2f MB", b / 1048576;
		else if (b >= 1024) printf "%.1f KB", b / 1024;
		else printf "%d B", b;
	}'
}

# Resolve parent whole-disk name (e.g. sda1 -> sda, nvme0n1p2 -> nvme0n1, mmcblk0p1 -> mmcblk0)
get_parent_disk() {
	local dev="$1"
	[ -z "$dev" ] && return
	dev="${dev#/dev/}"
	local pk=$(lsblk -ndo PKNAME "/dev/$dev" 2>/dev/null | head -n1)
	if [ -n "$pk" ]; then
		echo "$pk"
		return
	fi
	case "$dev" in
		nvme*n*p*|mmcblk*p*|loop*p*)
			echo "$dev" | sed 's/p[0-9]*$//'
			;;
		sd*[0-9]|vd*[0-9]|hd*[0-9])
			echo "$dev" | sed 's/[0-9]*$//'
			;;
		*)
			echo "$dev"
			;;
	esac
}

# Identify all system/protected disks (boot, rootfs, overlay, /opt)
get_protected_disks() {
	local protected=""
	local d=""

	# 1. Check /proc/cmdline root=PARTUUID=... or root=/dev/...
	local root_partuuid=$(sed -n 's/.*root=PARTUUID=\([^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
	if [ -n "$root_partuuid" ]; then
		local pdev=$(blkid -t PARTUUID="$root_partuuid" -o device 2>/dev/null | head -n1)
		d=$(get_parent_disk "$pdev")
		[ -n "$d" ] && protected="$protected $d"
	fi

	local cmd_root=$(sed -n 's/.*root=\(\/dev\/[^ ]*\).*/\1/p' /proc/cmdline 2>/dev/null)
	if [ -n "$cmd_root" ] && [ "$cmd_root" != "/dev/root" ]; then
		d=$(get_parent_disk "$cmd_root")
		[ -n "$d" ] && protected="$protected $d"
	fi

	# 2. Check critical mount points (/, /rom, /overlay, /boot, /opt)
	local mdev
	for mdev in $(awk '$2 ~ /^(\/|\/rom|\/overlay|\/boot|\/opt)$/ && $1 ~ /^\/dev\// {print $1}' /proc/mounts 2>/dev/null); do
		d=$(get_parent_disk "$mdev")
		[ -n "$d" ] && protected="$protected $d"
	done

	# 3. Check squashfs / DOCKER_DATA partition parent disk
	for mdev in $(blkid -t TYPE="squashfs" -o device 2>/dev/null) $(blkid -t LABEL="DOCKER_DATA" -o device 2>/dev/null); do
		d=$(get_parent_disk "$mdev")
		[ -n "$d" ] && protected="$protected $d"
	done

	echo "$protected" | tr ' ' '\n' | sed '/^$/d' | sort -u | tr '\n' ' ' | sed 's/ $//'
}

is_disk_protected() {
	local target="${1#/dev/}"
	local p
	for p in $(get_protected_disks); do
		[ "$target" = "$p" ] && return 0
	done
	return 1
}

cmd_status() {
	local protected_disks=$(get_protected_disks)

	# 1. Enumerate removable/candidate target disks
	local disks_json=""
	local sep=""
	local blk
	for blk in /sys/block/*; do
		[ -e "$blk" ] || continue
		local kname=$(basename "$blk")
		case "$kname" in
			loop*|ram*|zram*|mtdblock*|ubiblock*|nbd*|dm-*|md*|sr*) continue ;;
			mmcblk*boot*|mmcblk*rpmb*) continue ;;
		esac

		# Skip protected system disk(s)
		if is_disk_protected "$kname"; then
			continue
		fi

		local dev_path="/dev/$kname"
		[ -b "$dev_path" ] || continue

		local sectors=$(cat "$blk/size" 2>/dev/null || echo 0)
		[ "$sectors" -le 0 ] && continue
		local size_bytes=$(awk -v s="$sectors" 'BEGIN { printf "%.0f", s * 512 }')
		local size_str=$(human_size "$size_bytes")

		local vendor=$(cat "$blk/device/vendor" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		local model=$(cat "$blk/device/model" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
		local tran=$(lsblk -ndo TRAN "$dev_path" 2>/dev/null | head -n1)
		local rm_flag=$(cat "$blk/removable" 2>/dev/null || echo 0)
		local ro_flag=$(cat "$blk/ro" 2>/dev/null || echo 0)
		[ "$ro_flag" = "1" ] && continue

		local label_str="${vendor:+$vendor }${model:-Disk}"
		[ -n "$tran" ] && label_str="$label_str ($(echo "$tran" | tr 'a-z' 'A-Z'))"

		local mounts=$(awk -v p="^/dev/${kname}[0-9p]*" '$1 ~ p {print $2}' /proc/mounts 2>/dev/null | tr '\n' ' ' | sed 's/ $//')

		disks_json="${disks_json}${sep}{\"name\":\"$(json_escape "$kname")\",\"path\":\"$(json_escape "$dev_path")\",\"size_bytes\":$size_bytes,\"size_human\":\"$(json_escape "$size_str")\",\"model\":\"$(json_escape "$label_str")\",\"removable\":$rm_flag,\"mounts\":\"$(json_escape "$mounts")\"}"
		sep=","
	done

	# 2. Enumerate image files in /opt/downloads and /tmp/usb-writer
	local images_json=""
	sep=""
	local img_file
	for img_file in $(find /opt/downloads "$STATE_DIR" -maxdepth 2 -type f \( -iname "*.img" -o -iname "*.img.gz" -o -iname "*.img.xz" -o -iname "*.iso" -o -iname "*.raw" -o -iname "*.bin" \) 2>/dev/null | sort); do
		[ -f "$img_file" ] || continue
		local fname=$(basename "$img_file")
		local fsize=$(stat -c %s "$img_file" 2>/dev/null || wc -c < "$img_file" 2>/dev/null || echo 0)
		local fsize_str=$(human_size "$fsize")
		images_json="${images_json}${sep}{\"name\":\"$(json_escape "$fname")\",\"path\":\"$(json_escape "$img_file")\",\"size_bytes\":$fsize,\"size_human\":\"$(json_escape "$fsize_str")\"}"
		sep=","
	done

	# 3. Check running/completed flash job status
	local job_running="false"
	local job_phase="idle"
	local job_percent=0
	local job_written_human="0 B"
	local job_speed_human=""
	local job_elapsed=0
	local job_image=""
	local job_disk=""
	local job_error=""

	if [ -f "$STATE_FILE" ]; then
		. "$STATE_FILE"
		job_phase="${PHASE:-idle}"
		job_image="${IMAGE:-}"
		job_disk="${DISK:-}"
		job_error="${ERROR:-}"
		local start_ts="${START_TS:-0}"
		local now_ts=$(date +%s)
		[ "$start_ts" -gt 0 ] && job_elapsed=$((now_ts - start_ts))

		if [ "$job_phase" = "writing" ] || [ "$job_phase" = "syncing" ]; then
			if [ -n "${WORKER_PID:-}" ] && kill -0 "$WORKER_PID" 2>/dev/null; then
				job_running="true"
				local img_total="${IMG_SIZE:-0}"
				local read_pos=0
				local write_pos=0

				if [ -n "${READER_PID:-}" ] && [ -f "/proc/$READER_PID/fdinfo/0" ]; then
					read_pos=$(awk '/^pos:/ {print $2}' "/proc/$READER_PID/fdinfo/0" 2>/dev/null || echo 0)
				fi
				if [ -n "${WRITER_PID:-}" ] && [ -f "/proc/$WRITER_PID/fdinfo/1" ]; then
					write_pos=$(awk '/^pos:/ {print $2}' "/proc/$WRITER_PID/fdinfo/1" 2>/dev/null || echo 0)
				fi

				if [ "$job_phase" = "syncing" ]; then
					job_percent=99
					write_pos="${FINAL_WRITTEN:-$write_pos}"
				elif [ "$img_total" -gt 0 ] && [ "$read_pos" -gt 0 ]; then
					job_percent=$(awk -v r="$read_pos" -v t="$img_total" 'BEGIN { p = int(r * 100 / t); if (p > 99) p = 99; if (p < 1) p = 1; print p }')
				fi

				if [ "${write_pos:-0}" -gt 0 ]; then
					job_written_human=$(human_size "$write_pos")
					if [ "$job_elapsed" -gt 0 ]; then
						local bps=$(awk -v w="$write_pos" -v e="$job_elapsed" 'BEGIN { printf "%.0f", w / e }')
						job_speed_human="$(human_size "$bps")/s"
					fi
				fi
			else
				# Worker exited unexpectedly
				job_running="false"
				job_phase="error"
				job_error="烧录进程意外中断"
			fi
		elif [ "$job_phase" = "done" ]; then
			job_percent=100
			job_elapsed="${DURATION:-$job_elapsed}"
			if [ -n "${FINAL_WRITTEN:-}" ] && [ "$FINAL_WRITTEN" -gt 0 ]; then
				job_written_human=$(human_size "$FINAL_WRITTEN")
			fi
		fi
	fi

	printf '{"ok":true,"protected_disks":"%s","disks":[%s],"images":[%s],"job":{"running":%s,"phase":"%s","percent":%d,"written_human":"%s","speed_human":"%s","elapsed":%d,"image":"%s","disk":"%s","error":"%s"}}\n' \
		"$(json_escape "$protected_disks")" \
		"$disks_json" \
		"$images_json" \
		"$job_running" \
		"$(json_escape "$job_phase")" \
		"$job_percent" \
		"$(json_escape "$job_written_human")" \
		"$(json_escape "$job_speed_human")" \
		"$job_elapsed" \
		"$(json_escape "$job_image")" \
		"$(json_escape "$job_disk")" \
		"$(json_escape "$job_error")"
}

cmd_finalize_upload() {
	local tmp_file="$1"
	local orig_name="$2"
	if [ ! -f "$tmp_file" ]; then
		printf '{"ok":false,"error":"上传的临时文件不存在"}\n'
		return 1
	fi
	local safe_name=$(printf '%s' "$orig_name" | sed 's/[^A-Za-z0-9._-]/_/g')
	[ -z "$safe_name" ] && safe_name="uploaded-image.img.gz"

	local target_dir="/opt/downloads"
	mkdir -p "$target_dir" 2>/dev/null || target_dir="$STATE_DIR"
	local final_path="$target_dir/$safe_name"
	mv -f "$tmp_file" "$final_path" 2>/dev/null || {
		printf '{"ok":false,"error":"无法保存上传的镜像文件到 %s"}\n' "$target_dir"
		return 1
	}
	printf '{"ok":true,"path":"%s","name":"%s"}\n' "$(json_escape "$final_path")" "$(json_escape "$safe_name")"
}

cmd_delete_image() {
	local img_path="$1"
	case "$img_path" in
		/opt/downloads/*|/tmp/usb-writer/*)
			if [ -f "$img_path" ]; then
				rm -f "$img_path"
				printf '{"ok":true}\n'
				return 0
			fi
			;;
	esac
	printf '{"ok":false,"error":"无效的镜像文件路径"}\n'
	return 1
}

cmd_start() {
	local img_path="$1"
	local disk_path="$2"

	if [ -f "$STATE_FILE" ]; then
		. "$STATE_FILE"
		if [ -n "${WORKER_PID:-}" ] && kill -0 "$WORKER_PID" 2>/dev/null; then
			printf '{"ok":false,"error":"已有烧录任务正在运行中"}\n'
			return 1
		fi
	fi

	if [ -z "$img_path" ] || [ ! -f "$img_path" ]; then
		printf '{"ok":false,"error":"所选镜像文件不存在: %s"}\n' "$(json_escape "$img_path")"
		return 1
	fi

	if [ -z "$disk_path" ] || [ ! -b "$disk_path" ]; then
		printf '{"ok":false,"error":"所选目标磁盘设备不存在: %s"}\n' "$(json_escape "$disk_path")"
		return 1
	fi

	# Critical safety gate: NEVER allow writing to protected system disks
	if is_disk_protected "$disk_path"; then
		printf '{"ok":false,"error":"安全拦截：禁止向当前系统启动盘 (%s) 刷写镜像！"}\n' "$(json_escape "$disk_path")"
		return 1
	fi

	local img_size=$(stat -c %s "$img_path" 2>/dev/null || echo 0)
	local start_ts=$(date +%s)
	rm -f "$ERR_LOG"

	cat > "$WORKER_SCRIPT" << 'EOF'
#!/bin/sh
STATE_FILE="/tmp/usb-writer/state.json"
ERR_LOG="/tmp/usb-writer/dd.err"
IMG="$1"
DISK="$2"
IMG_SIZE="$3"
START_TS="$4"

write_state() {
	cat > "${STATE_FILE}.tmp" << STATE_EOF
PHASE="$1"
WORKER_PID="$$"
READER_PID="${READER_PID:-}"
WRITER_PID="${WRITER_PID:-}"
IMAGE="$IMG"
DISK="$DISK"
IMG_SIZE="$IMG_SIZE"
START_TS="$START_TS"
DURATION="${DURATION:-0}"
FINAL_WRITTEN="${FINAL_WRITTEN:-0}"
ERROR="${2:-}"
STATE_EOF
	mv -f "${STATE_FILE}.tmp" "$STATE_FILE"
}

# 1. Unmount any mounted partitions on the target disk
for mp in $(awk -v p="^${DISK}[0-9p]*" '$1 ~ p {print $1}' /proc/mounts 2>/dev/null); do
	umount -f "$mp" 2>/dev/null || umount -l "$mp" 2>/dev/null || true
done

FIFO="/tmp/usb-writer/pipe.$$"
rm -f "$FIFO"
mkfifo "$FIFO"

case "$IMG" in
	*.gz|*.GZ)
		gzip -dc < "$IMG" > "$FIFO" 2>>"$ERR_LOG" &
		READER_PID=$!
		dd bs=4M < "$FIFO" > "$DISK" 2>>"$ERR_LOG" &
		WRITER_PID=$!
		;;
	*.xz|*.XZ)
		xz -dc < "$IMG" > "$FIFO" 2>>"$ERR_LOG" &
		READER_PID=$!
		dd bs=4M < "$FIFO" > "$DISK" 2>>"$ERR_LOG" &
		WRITER_PID=$!
		;;
	*)
		rm -f "$FIFO"
		dd bs=4M < "$IMG" > "$DISK" 2>>"$ERR_LOG" &
		READER_PID=$!
		WRITER_PID=$!
		;;
esac

write_state "writing" ""

# Wait for processes and track final written bytes before exit
LAST_POS=0
while kill -0 "$WRITER_PID" 2>/dev/null; do
	if [ -f "/proc/$WRITER_PID/fdinfo/1" ]; then
		POS=$(awk '/^pos:/ {print $2}' "/proc/$WRITER_PID/fdinfo/1" 2>/dev/null)
		[ -n "$POS" ] && [ "$POS" -gt 0 ] && LAST_POS="$POS"
	fi
	sleep 1
done

wait "$WRITER_PID"
W_RC=$?
if [ "$READER_PID" != "$WRITER_PID" ]; then
	wait "$READER_PID"
	R_RC=$?
else
	R_RC=0
fi
rm -f "$FIFO"

FINAL_WRITTEN="$LAST_POS"
if [ "$W_RC" -ne 0 ] || [ "$R_RC" -ne 0 ]; then
	ERR_MSG=$(tail -n 2 "$ERR_LOG" 2>/dev/null | tr '\n' ' ' | sed 's/"/ /g')
	[ -z "$ERR_MSG" ] && ERR_MSG="写入或解压过程出错 (exit $R_RC/$W_RC)"
	write_state "error" "$ERR_MSG"
	exit 1
fi

write_state "syncing" ""
sync
partprobe "$DISK" >/dev/null 2>&1 || true
END_TS=$(date +%s)
DURATION=$((END_TS - START_TS))
write_state "done" ""
exit 0
EOF

	chmod 0755 "$WORKER_SCRIPT"
	"$WORKER_SCRIPT" "$img_path" "$disk_path" "$img_size" "$start_ts" >/dev/null 2>&1 &
	sleep 1
	printf '{"ok":true}\n'
}

cmd_stop() {
	if [ -f "$STATE_FILE" ]; then
		. "$STATE_FILE"
		[ -n "${READER_PID:-}" ] && kill -9 "$READER_PID" 2>/dev/null || true
		[ -n "${WRITER_PID:-}" ] && kill -9 "$WRITER_PID" 2>/dev/null || true
		[ -n "${WORKER_PID:-}" ] && kill -9 "$WORKER_PID" 2>/dev/null || true
		rm -f "$STATE_DIR"/pipe.* 2>/dev/null || true
		cat > "$STATE_FILE" << EOF
PHASE="error"
IMAGE="${IMAGE:-}"
DISK="${DISK:-}"
START_TS="${START_TS:-0}"
ERROR="用户手动中止了烧录任务"
EOF
	fi
	printf '{"ok":true}\n'
}

case "$1" in
	status)
		cmd_status
		;;
	finalize_upload)
		cmd_finalize_upload "$2" "$3"
		;;
	delete_image)
		cmd_delete_image "$2"
		;;
	start)
		cmd_start "$2" "$3"
		;;
	stop)
		cmd_stop
		;;
	*)
		printf '{"ok":false,"error":"未知命令: %s"}\n' "$(json_escape "$1")"
		exit 1
		;;
esac
